---
import Button from "./Button.astro"
---
<article>
<div class="relative w-full ">
  <!-- Grid container -->
  <div class="hero-grid w-full h-full absolute inset-0 overflow-hidden">

    <div class="grid-item col-start-1 col-span-2 row-start-1 row-span-1 md:col-start-1 md:col-span-2 md:row-start-1 md:row-span-1 flex ">
      <img src="/blok/langblok_cropped.png" alt="Logo" />
    </div>

    <div class="grid-item col-start-5 col-span-2 row-start-2 row-span-1  md:col-start-6 md:col-span-2 md:row-start-1 md:row-span-1 flex ">
      <img src="/blok/langblok.png" alt="Logo" />
    </div>

     <div class="grid-item col-start-1 col-span-1 row-start-3 row-span-1  md:col-start-9 md:col-span-1 md:row-start-1 md:row-span-1 flex ">
      <img src="/blok/lilleblok.png" alt="Logo" />
    </div>

    <div class="grid-item col-start-3 col-span-1 row-start-4 row-span-1  md:col-start-10 md:col-span-1 md:row-start-2 md:row-span-1 flex ">
      <img src="/blok/lilleblok_stroke.png" alt="Logo" />
    </div>

    <div class="grid-item col-start-6 col-span-1 row-start-6 row-span-1  md:col-start-4 md:col-span-2 md:row-start-3 md:row-span-1 flex ">
      <img src="/blok/langblok.png" alt="Logo" />
    </div>

    <div class="grid-item hidden md:col-start-7 md:col-span-1 md:row-start-3 md:row-span-1 md:flex ">
      <img src="/blok/lilleblok.png" alt="Logo" />
    </div>

    <div class="grid-item col-start-1 col-span-1 row-start-7 row-span-1 md:col-start-1 md:col-span-1 md:row-start-5 md:row-span-1 flex">
      <img src="/blok/lilleblok_stroke.png" alt="Logo" />
    </div>

    <div class="grid-item hidden md:col-start-6 md:col-span-2 md:row-start-4 md:row-span-1 md:flex ">
      <img src="/blok/langblok_stroke.png" alt="Logo" />
    </div>

    <div class="grid-item hidden md:col-start-7 md:col-span-2 md:row-start-5 md:row-span-1 md:flex ">
      <img src="/blok/langblok.png" alt="Logo" />
    </div>

     <div class="grid-item hidden md:col-start-2 md:col-span-2 md:row-start-6 md:row-span-1 md:flex ">
      <img src="/blok/langblok_stroke.png" alt="Logo" />
    </div>

     <div class="grid-item hidden md:col-start-9 md:col-span-1 md:row-start-6 md:row-span-1 md:flex ">
      <img src="/blok/lilleblok_stroke.png" alt="Logo" />
    </div>

    <div class="grid-item col-start-1 col-span-2 row-start-10 row-span-1  md:col-start-5 md:col-span-2 md:row-start-9 md:row-span-1 flex ">
      <img src="/blok/langblok.png" alt="Logo" />
    </div>

     <div class="grid-item col-start-6 col-span-1 row-start-10 row-span-1 md:col-start-8 md:col-span-1 md:row-start-10 md:row-span-1 flex">
      <img src="/blok/lilleblok_stroke.png" alt="Logo" />
    </div>


     <div class="grid-item hidden  md:col-start-6 md:col-span-2 md:row-start-1 md:row-span-1 md:flex ">
      <img src="/blok/langblok_cropped.png" alt="Logo" />
    </div>

    
   
<div class="grid-item hidden md:col-start-1 md:col-span-2 md:row-start-9 md:row-span-1 md:flex ">
      <img src="/blok/langblok_stroke.png" alt="Logo" />
    </div>

    <div class="grid-item hidden md:col-start-4 md:col-span-2 md:row-start-10 md:row-span-1 md:flex ">
      <img src="/blok/langblok.png" alt="Logo" />
    </div>

    <div class="grid-item col-start-2 col-span-4 row-start-5 row-span-3 md:col-start-2 md:col-span-4 md:row-start-7 md:row-span-2 flex">
  <p class="text-[15px] md:text-[20px] text-[#272727] mt-10 md:mt-15 ml-4 mr-4 tracking-tighter font-suisse">
    Hej. Vi er ALICE - et eksperimenterende spillested for grænseprægende musik og lyd. <br><br>
    Her kan du opleve alt fra nye lydlige nybrud til musikalske legender i intime rammer.  <br><br>
    <a href="/omalice" class="text-[#4A40FF] pointer-events-auto">Læs mere</a>
  </p>
</div>


    <!-- H1 placeret perfekt -->
    <div class="grid-item col-start-2 col-span-3 row-start-2 row-span-1 md:col-start-2 md:col-span-4 md:row-start-2 md:row-span-1 flex  pointer-events-none justify-center items-center md:justify-start ">
      <h1 class="text-[90px] md:text-[150px] text-[#272727]">ALICE</h1>
    </div>

    <!-- Logo under H1 -->
    <div class="grid-item col-start-5 col-span-6 row-start-3 row-span-2 md:col-start-8 md:col-span-2 md:row-start-3 md:row-span-2 flex justify-center items-center">
      <img src="/logo/272727_logo.png" alt="Logo" class="w-3/4 h-auto md:w-3/4 md:h-auto object-contain" />
    </div>

    <!-- Stemningsbillede -->
    <div class="grid-item col-start-1 col-span-4 row-start-3 row-span-2 md:col-start-2 md:col-span-4 md:row-start-4 md:row-span-2 flex">
  <img
    id="stemning-slideshow"
    src="/img/stemning1.webp"
    alt="Stemning"
    class="object-cover w-full h-full"
  />
</div>

    <div class="grid-item col-start-3 col-span-4 row-start-8 row-span-2 md:col-start-6 md:col-span-4 md:row-start-7 md:row-span-2 flex">
  <img
    id="stemning-slideshow-2"
    src="/img/stemning2.webp"
    alt="Stemning"
    class="object-cover w-full h-full"
  />
</div>

  </div>
</div>
</article>

<style>
.hero-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: repeat(10, 10vw);
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden; /* Alt udenfor grid-celler bliver klippet */
  
}

.grid-item {
  position: relative;
  overflow: hidden; /* Alt udenfor kolonner/rækker klippes */
  
}

@media (max-width: 768px) {
  .hero-grid {
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(10, 16vw); /* nu 10 rækker på mobil */
  }
}


</style>

<script>
  const images = [
    "/img/stemning1.webp",
    "/img/stemning4.webp",
    "/img/stemning6.webp",
    "/img/stemning5.webp"
  ];

  let index = 0;
  const imgEl = document.getElementById("stemning-slideshow");

  setInterval(() => {
    index = (index + 1) % images.length;
    imgEl.src = images[index];
  }, 1500); // skifter hver 3. sekund

  const images2 = [
    "/img/stemning2.webp",
    "/img/stemning3.webp",
    "/img/stemning7.webp",
    "/img/stemning8.webp"
  ];

  let index2 = 0;
  const imgEl2 = document.getElementById("stemning-slideshow-2");

  setInterval(() => {
    index2 = (index2 + 1) % images2.length;
    imgEl2.src = images2[index2];
  }, 1500);
</script>