---
interface Props {
  date: string;
  artist: string;
  origin: string; // fx "etnicitet"
  extraClass?: string;
  highlight?: boolean;
  month?: string;   // fx "November"
  genre?: string;   // fx "folk", "electronic"
}

const {
  date,
  artist,
  origin,
  extraClass = "",
  highlight = false,
  month = "",
  genre = "",
} = Astro.props;

let colorClasses = highlight
  ? "bg-[#4A40FF] text-[#000000]"
  : "bg-[#E8A9C4] text-[#272727]";
---

<!--
  month og genre er ikke synlige, men findes som data-attributes for filtrering:
  <div data-month="November" data-genre="folk"> ...
-->
<a href="/singleview" class="block w-full h-full">
  <div
  class={`relative px-6 py-5 w-full h-full font-suisse tracking-widest 
    ${colorClasses} ${extraClass} 
    border-0 
    hover:border-[3px] md:hover:border-[5px]
    transition-all duration-200
    ${highlight ? 'hover:border-[#E8A9C4]' : 'hover:border-[#4A40FF]'}`}
  data-month={month}
  data-genre={genre}
>

{origin && (
  <div class="absolute top-2 right-2 md:top-4 md:right-4 
              text-[16px] md:text-[20px] font-suisse tracking-widest
               text-[#272727] px-2 py-1 ">
    {origin}
  </div>
)}



    <!-- Dato -->
    <div class="text-[30px] md:text-[60px] leading-none mb-2 font-suisse tracking-widest">
      {date}
    </div>

    <!-- Kunstnernavn + pil -->
    <div class="relative text-[18px] md:text-[25px] leading-snug font-suisse tracking-widest pr-8">
      {artist}
      <!-- Pil -->
      <span class="absolute bottom-0 right-0 text-[20px] md:text-[30px]">
        →
      </span>
    </div>
  </div>
</a>


