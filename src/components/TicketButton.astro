---
interface Props {
  href?: string;          // valgfri – når I får en rigtig billet-side
  label?: string;         // venstre tekst
  fromLabel?: string;     // "Fra"
  priceLabel?: string;    // "160 dkk"
  feeLabel?: string;      // "+ GEBYR"
}

const {
  href,
  label = "KØB BILLET",
  fromLabel = "Fra",
  priceLabel = "160 dkk",
  feeLabel = "+ GEBYR",
} = Astro.props;
---
{href ? (
  <a href={href} class="block w-full">
    <div class="group w-full border-3 md:border-5 border-[#3B2CFF] bg-white cursor-pointer">
      <div class="grid grid-cols-2 h-12 w-full">

        <!-- VENSTRE DEL (KØB BILLET) — HOVER BLIVER BLÅ -->
        <div class="bg-[#E8A9C4] flex items-center justify-center
                    transition-colors duration-200
                    group-hover:bg-[#3B2CFF] group-hover:text-white">
          <span class="font-suisse tracking-[0.12em] text-[15px] md:text-[20px] uppercase">
            {label}
          </span>
        </div>

        <!-- HØJRE DEL (PRIS) — INGEN HOVER -->
        <div class="bg-black text-white flex items-center justify-center">
          <span class="font-suisse tracking-[0.08em] text-[14px] md:text-[16px]">
            {fromLabel} <strong class="text-[18px] font-normal">{priceLabel}</strong> {feeLabel}
          </span>
        </div>

      </div>
    </div>
  </a>
) : (
  <div class="group w-full border-3 md:border-5 border-[#3B2CFF] bg-white cursor-pointer">
    <div class="grid grid-cols-2 h-12 w-full">

      <!-- VENSTRE DEL (STATISK VERSION) -->
      <div class="bg-[#E8A9C4] flex items-center justify-center
                  transition-colors duration-200
                  group-hover:bg-[#3B2CFF] group-hover:text-white">
        <span class="font-suisse tracking-[0.12em] text-[15px] md:text-[20px] uppercase">
          {label}
        </span>
      </div>

      <!-- HØJRE DEL (PRIS) -->
      <div class="bg-black text-white flex items-center justify-center">
        <span class="font-suisse tracking-[0.08em] text-[14px] md:text-[16px]">
          {fromLabel} <strong class="text-[18px] font-normal">{priceLabel}</strong> {feeLabel}
        </span>
      </div>

    </div>
  </div>
)}





