---
import Button from './Button.astro';
let isOpen = false;
---


<div 
  x-data="{ open: false, show: true }" 
  x-init="() => {
    const btn = $el;
    const footer = document.querySelector('footer'); 
    const topOffset = window.innerWidth >= 768 ? 470 : 350; // top på desktop/mobil
    const updatePosition = () => {
      const footerRect = footer.getBoundingClientRect();
      if (footerRect.top < window.innerHeight + window.scrollY - btn.offsetHeight - 20) {
        // footer nærmer sig: fade out
        show = false;
      } else {
        show = true;
      }
    };
    window.addEventListener('scroll', updatePosition);
    window.addEventListener('resize', updatePosition);
    updatePosition();
  }"
  class="fixed left-4 z-[99999] transition-all duration-200"
  :class="{ 'opacity-0 pointer-events-none': !show, 'opacity-100': show }"
  :style="`top: ${window.innerWidth >= 768 ? '470px' : '350px'}`"
>
  <!-- Sticky label -->
  <button 
    @click="open = true"
    class="z-[99999] rotate-[-90deg] origin-left 
           border-[3px] md:border-[5px]
           text-[#272727] border-[#4A40FF]
           px-3 py-2 text-[15px] lg:text-[20px]
           font-suisse tracking-widest
           bg-cover bg-center
           hover:text-[#4A40FF] 
           transition-colors duration-100"
    style="background-image: url('/logo/alice_baggrund.png');"
  >
    NYHEDSBREV
  </button>

  <!-- Overlay -->
  <div
    x-show="open"
    @click="open = false"
    class="fixed inset-0 bg-black/30 lg:bg-transparent z-[99998]"
  ></div>

  <!-- Slide-out panel -->
  <div
    x-show="open"
    x-transition
    class="
      fixed left-0
      top-[15vh] md:top-[20vh]
      h-[70vh] md:h-[70vh]
      bg-white shadow-2xl
      border-y-[3px] md:border-y-[5px]
      border-r-[3px] md:border-r-[5px]
      border-[#4A40FF]
      flex items-center justify-center
      p-6 overflow-y-auto
      w-[90vw] max-w-[600px]
      lg:w-[40vw] lg:max-w-none
      z-[100000]
    "
    style="background-image: url('/logo/alice_baggrund.png');"
  >
    <!-- Close button -->
    <button 
      @click="open = false"
      class="absolute right-6 top-6 text-2xl leading-none"
    >
      ✕
    </button>

    <!-- Centered content wrapper -->
    <div class="w-full max-w-md flex flex-col justify-center">

      <h2 class="text-[20px] md:text-[30px] font-suisse mb-6 tracking-widest text-[#272727]">
        NYHEDSBREV
      </h2>

      <p class="text-[14px] md:text-[16px] leading-relaxed tracking-widest font-suisse mb-6 text-[#272727]">
        Tilmeld dig vores nyhedsbrev og modtag løbende koncertanbefalinger,
        tilbud, ALICE-nyheder og eksklusive presales.
      </p>

      <form class="flex flex-col gap-4">
        <input 
          type="text"
          placeholder="Navn + efternavn"
          class="border-[3px] md:border-[5px]
                 border-[#E8A9C4]
                 px-3 py-2 w-full
                 focus:outline-none
                 tracking-widest font-suisse"
        />

        <input 
          type="email"
          placeholder="Email"
          class="border-[3px] md:border-[5px]
                 border-[#E8A9C4]
                 px-3 py-2 w-full
                 focus:outline-none
                 tracking-widest font-suisse"
        />

        <Button text="TILMELD" direction="right" />
      </form>

    </div>
  </div>
</div>

