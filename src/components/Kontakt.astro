---
import Button from "./Button.astro"
---
<article>
<div class="relative w-full ">
  <!-- Grid container -->
  <div class="hero-grid w-full h-full absolute inset-0 overflow-hidden">


    
   

    <!-- H1 placeret perfekt -->
    <div class="grid-item col-start-2 col-span-1 row-start-5 row-span-1 md:col-start-2 md:col-span-1 md:row-start-1 md:row-span-1 flex  pointer-events-none md:justify-center md:items-center ml-4 " >
      <h3 class="text-[20px] md:text-[30px] text-[#272727] tracking-tighter">Kontakt</h3>
    </div>

    <!-- p placeret perfekt -->
    <div class="grid-item col-start-2 col-span-4 row-start-5 row-span-3 md:col-start-2 md:col-span-3 md:row-start-2 md:row-span-2 flex  pointer-events-none mt-10 md:mt-0 mr-4 ml-4" >
      <p class="text-[15px] md:text-[20px] text-[#272727] mt-5 md:mt-5 tracking-tighter font-suisse"> ALICEs kan træffes telefonisk på kontoret hverdage fra kl. 10-14. Uden for telefontid bedes du skrive en mail, så vender vi tilbage til dig hurtigst muligt. Alle booking-henvendelser skal ske pr. mail til booking@alicecph.com.</p>
    </div>

     <!-- p2 placeret perfekt -->
    <div class="grid-item col-start-2 col-span-4 row-start-7 row-span-3 md:col-start-2 md:col-span-3 md:row-start-3 md:row-span-4 flex  pointer-events-none mt-5 mr-4 ml-4 md:mt-10" >
      <p class="text-[15px] md:text-[20px] text-[#272727] mt-5 md:mt-5 tracking-tighter font-suisse"> 
        Fonden ALICE <br>
        Nørre Allé 7 <br>
        DK-2200 København N <br>
        Tlf.: +45 31 54 58 75 <br>
        info@alice.com <br>
        CVR/VAT: 3912 7318
      </p>
    </div>

     <!-- H1.2 placeret perfekt -->
    <div class="grid-item col-start-2 col-span-2 row-start-10 row-span-1 md:col-start-7 md:col-span-2 md:row-start-3 md:row-span-1 flex  pointer-events-none md:justify-center md:items-center ml-4 md:ml-0" >
      <h3 class="text-[20px] md:text-[30px] text-[#272727] tracking-tighter">ALICE er støttet af</h3>
    </div>

     <!-- kommune -->
    <div class="grid-item col-start-2 col-span-2 row-start-10 row-span-2 md:col-start-6 md:col-span-1 md:row-start-3 md:row-span-2 flex justify-center items-center mt-10 md:mt-15">
      <img src="/logo/kommune.png" alt="Logo" class="w-2/4 h-auto md:w-3/4 md:h-auto object-contain" />
    </div>
    <!-- tuborg -->
    <div class="grid-item col-start-2 col-span-4 row-start-11 row-span-2 md:col-start-7 md:col-span-2 md:row-start-3 md:row-span-2 flex justify-center items-center mt-10 md:mt-15">
      <img src="/logo/tuborg.png" alt="Logo" class="w-2/4 h-auto md:w-3/4 md:h-auto object-contain" />
    </div>
 <!-- fond -->
    <div class="grid-item col-start-4 col-span-2 row-start-10 row-span-2 md:col-start-9 md:col-span-1 md:row-start-3 md:row-span-2 flex justify-center items-center mt-10 md:mt-15">
      <img src="/logo/kunstfond.png" alt="Logo" class="w-1/4 h-auto md:w-2/4 md:h-auto object-contain" />
    </div>


    <!-- Stemningsbillede -->
    <div class="grid-item col-start-2 col-span-4 row-start-2 row-span-2 md:col-start-6 md:col-span-4 md:row-start-1 md:row-span-2 flex ">
      <img src="/img/stemning5.webp" alt="Stemning" class="object-cover w-full h-full" />
    </div>

  </div>
</div>
</article>

<style>
.hero-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: repeat(4, 10vw); /* VAR 6 → NU 4 */
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.grid-item {
  position: relative;
  overflow: hidden;
}

@media (max-width: 768px) {
  .hero-grid {
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(11, 16vw); /* VAR 13 → NU 11 */
  }
}


</style>