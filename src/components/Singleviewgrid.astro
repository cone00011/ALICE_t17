---
import Button from "./Button.astro";
import TicketButton from "../components/TicketButton.astro";
import FloatingTicketBar from "../components/FloatingTicketBar.astro";
---

<article>
<div class="relative w-full">
  <!-- Grid container -->
  <div class="hero-grid w-full h-full">

    <div class="grid-item col-start-2 col-span-5 row-start-2 row-span-3 md:col-start-6 md:col-span-4 md:row-start-2 md:row-span-4 flex ml-3 pointer-events-none">
      <h1 class="text-5xl md:text-[110px] font-suisse">Nadah El Shazly  + 
       Nova Varnrable</h1>
    </div> 

    <div class="grid-item  col-start-2 col-span-4 row-start-9 row-span-3 md:col-start-6 md:col-span-4 md:row-start-5 md:row-span-4  flex  pointer-events-none">
      <p class="text-[15px] md:text-[20px] font-suisse">Velkommen på klubben, hvor hjerterne bløder, og hvor hjerterne brænder. Se frem til en koncertaften i den eksperimenterende, elektroniske musiks tegn, når Nova Varnrable og Nadah El Shazly fylder koncertsalen med et spektrum af lyde på tværs af genrer, traditioner og udtryk.</p>
    </div> 

       <!-- Logo under ved billede -->
    <div class="grid-item col-start-5 col-span-2 row-start-3 row-span-2 md:col-start-1 md:col-span-2 md:row-start-1 md:row-span-2 flex justify-center items-center z-10">
      <img src="/logo/272727_logo.png" alt="Logo" class="w-3/4 h-auto md:w-3/4 md:h-auto object-contain" />
    </div>

    <!-- nadah_billede -->
    <div class="grid-item col-start-2 col-span-4 row-start-4 row-span-4 md:col-start-2 md:col-span-4 md:row-start-2 md:row-span-4 flex ">
      <img src="/img/nadah.webp" alt="nadah" class="object-cover w-full h-full" />
    </div>

    <div class="grid-item col-start-2 col-span-4 row-start-7 row-span-2 
            md:col-start-2 md:col-span-3 md:row-start-6 md:row-span-1 
            flex pointer-events-none
            border-[3px] md:border-[5px] border-[#4A40FF]
            bg-cover bg-center
            w-[265px] md:w-[360px]
            h-[135px] md:h-[160px]"
     style="background-image: url('/logo/alice_baggrund.png');">

  <p class="text-[15px] md:text-[20px] font-suisse ">
    Torsdag 20.11.25<br>
    Dørene åbner kl: 19:00<br>
    Koncerten starter kl: 20:00<br>
    Stående
  </p>

</div>



     <div class="grid-item hidden col-start-1 col-span-1 row-start-7 row-span-1 md:col-start-10 md:col-span-1 md:row-start-8 md:row-span-1 md:flex ">
      <img src="/blok/lilleblok.png" alt="Logo" />
    </div>

     <div class="grid-item col-start-1 col-span-2 row-start-22 row-span-1 md:col-start-5 md:col-span-2 md:row-start-10 md:row-span-1 flex ">
      <img src="/blok/langblok.png" alt="Logo" />
    </div>

    <div class="grid-item col-start-5 col-span-2 row-start-1 row-span-1 md:col-start-5 md:col-span-2 md:row-start-1 md:row-span-1 flex ">
      <img src="/blok/langblok.png" alt="Logo" />
    </div>

    <div class="grid-item hidden md:col-start-10 md:col-span-2 md:row-start-2 md:row-span-2 md:flex ">
      <img src="/blok/langblok_stroke_oprejst.png" alt="Logo" />
    </div>

     <div class="grid-item col-start-1 col-span-1 row-start-3 row-span-1 md:col-start-1 md:col-span-1 md:row-start-5 md:row-span-1 flex ">
      <img src="/blok/lilleblok_stroke.png" alt="Logo" />
    </div>

  <div class="grid-item col-start-2 col-span-3 row-start-12 row-span-3 md:col-start-7 md:col-span-3 md:row-start-8 md:row-span-3 relative">

     <!-- BILLEDET -->
     <img src="/img/nadah.webp" alt="nadah" class="object-cover w-full h-full block" />

     <!-- PLAY-KNAP (overlay) -->
    <button 
    type="button"
    data-audio-id="nadah-audio"
    class="absolute inset-0 flex items-center justify-center 
           bg-black/20 hover:bg-black/30 
           text-white text-3xl rounded-full m-auto h-16 w-16">
    ▶
    </button>

    <!-- AUDIO -->
  
  </div>

  <div class="grid-item col-start-2 col-span-3 row-start-15 row-span-1 ml-3 md:col-start-2 md:col-span-3 md:row-start-7 md:row-span-1 md:ml-3 flex pointer-events-none items-center">
      <h3 class="text-[20px] md:text-[30px] font-suisse">Nadah el shazly</h3>
    </div> 

    <div class="grid-item col-start-2 col-span-4 row-start-16 row-span-4 ml-3 md:col-start-2 md:col-span-4 md:row-start-8 md:row-span-4 flex flex-col gap-4">

   <p class="text-[15px] md:text-[20px] font-suisse leading-relaxed">
    Den egyptiske sangerinde og komponist Nadah El Shazly
    er en af hovedskikkelserne på den eksperimenterende
    musikscene i Cairo. Hun forener rødder fra den traditionelle
    arabiske musik med moderne jazz, elektronik og eksperimenterende rock, og for den genreblanding.
   </p>
   <div x-data="{ open: false }">
  <!-- Trigger -->
  <button 
    @click="open = true" 
    class="text-[15px] md:text-[20px] font-suisse leading-relaxed ml-4 cursor-pointer text-[#4A40FF]"
  >
    Læs mere
  </button>

  <!-- Overlay -->
  <div
    x-show="open"
    x-transition.opacity
    class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40"
    @click="open = false"
  ></div>

  <!-- Modal box -->
  <div 
    x-show="open"
    x-transition
    @click.stop
    class="
      fixed z-50  p-6 overflow-y-auto
      w-[90%] h-[60%]
      md:w-[600px] md:h-[500px]
      left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2
      border-[#4A40FF] border-[3px] md:border-[5px]
    "
    style="background-image: url('/logo/alice_baggrund.png');"
  >

    <!-- Close button -->
    <button 
      @click="open = false"
      class="absolute top-4 right-4 text-2xl font-bold cursor-pointer hover:text-[#4A40FF]"
    >
      ✕
    </button>

    <!-- Popup content -->
    <div class="text-[15px] md:text-[20px] font-suisse leading-relaxed space-y-4">
      <h2 class="text-[20px] md:text-[30px] font-suisse">Nadah el shazly</h2>
      <p>
       Den egyptiske sangerinde og komponist Nadah El Shazly er en af hovedskikkelserne på den eksperimenterende musikscene i Cairo. Hun forener rødder fra den traditionelle arabiske musik med moderne jazz, elektronik og eksperimenterende rock, og for den genreblanding, og for hendes fortryllende vokaler og avant-garde arrangementer, har hun vundet fans verden over. Som helt ung begik Nadah El Shazly sig på den egyptiske punkscene, inden hun begyndte at eksperimentere med elektronisk musik. I 2017 brød hun igennem med det overdådige album ‘Ahwar’, som modtog fremragende anmeldelser og havnede bl.a. på en prominent 12. plads på The Wires liste over årets album. Og i juni udkom den længe ventede efterfølger ‘Laini Tani’. <br> <br>

‘Laini Tani’, der også er blevet taget godt imod af anmelderne, formidler en følelse af lune nætter, der strækker sig og bliver til morgendag. Albummet har nemlig den her sensuelle, men flygtige stemning over sig. På ‘Laini Tani’ væver Nadah El Shazly egyptisk improvisation, stemmemanipulation og elektroniske beats sammen til kunstnerisk udtryk, som omfavner både sårbarhed og sætter en stor fed streg under musikkens forunderlige kraft. Nadah El Shazly har spillet på ALICE i 2019 og i 2022, og i år kunne man også opleve hende på Roskilde Festival, hvor hun fik væggene på Gloria til at dirre og al sniksnak i hjørnerne til at ophøre. Med andre ord havde hun publikum i sin hule hånd! Nadah El Shazly formår nemlig at forene en klubbet koncertoplevelse med et enormt stort nærvær – og derfor ser vi så meget frem til igen at præsentere den banebrydende, elektroniske musiker tilbage på vores scene!
      </p>
    </div>

  </div>
</div>


  </div>

  <div class="grid-item col-start-3 col-span-3 row-start-20 row-span-3 md:col-start-2 md:col-span-3 md:row-start-13 md:row-span-3 relative">

     <!-- BILLEDET -->
     <img src="/img/nora.webp" alt="nora" class="object-cover w-full h-full block" />

     <!-- PLAY-KNAP (overlay) -->
    <button 
    type="button"
    data-audio-id="nora-audio"
    class="absolute inset-0 flex items-center justify-center 
           bg-black/20 hover:bg-black/30 
           text-white text-3xl rounded-full m-auto h-16 w-16">
    ▶
    </button>

    <!-- AUDIO -->
  
  </div>

      <div class="grid-item col-start-2 col-span-4 row-start-23 row-span-1 ml-3 md:col-start-6 md:col-span-4 md:row-start-11 md:row-span-3 flex items-center pointer-events-none">
      <h3 class="text-[20px] md:text-[30px] font-suisse">Nova Varnrable</h3>
    </div> 

    <div class="grid-item col-start-2 col-span-4 row-start-24 row-span-4 ml-3 md:col-start-6 md:col-span-4 md:row-start-13 md:row-span-4 flex flex-col gap-4">

   <p class="text-[15px] md:text-[20px] font-suisse leading-relaxed">
    Med glitches former Nova Varnrable gribende fortællinger. Den etiopisk-norske kunstner og musikproducer med base i København, er internationalt kendt for sin eksperimenterende elektroniske musik. Hendes sange bevæger sig gennem et spektrum af lyde, der bryder genrer, bygger scenarier op, samt udforsker kompositionens muligheder.  
   </p>

   <div x-data="{ open: false }">
  <!-- Trigger -->
  <button 
    @click="open = true" 
    class="text-[15px] md:text-[20px] font-suisse leading-relaxed ml-4 cursor-pointer text-[#4A40FF]"
  >
    Læs mere
  </button>

  <!-- Overlay -->
  <div
    x-show="open"
    x-transition.opacity
    class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40"
    @click="open = false"
  ></div>

  <!-- Modal box -->
  <div 
    x-show="open"
    x-transition
    @click.stop
    class="
      fixed z-50  p-6 overflow-y-auto
      w-[90%] h-[60%]
      md:w-[600px] md:h-[500px]
      left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2
      border-[#4A40FF] border-[3px] md:border-[5px]
    "
    style="background-image: url('/logo/alice_baggrund.png');"
  >

    <!-- Close button -->
    <button 
      @click="open = false"
      class="absolute top-4 right-4 text-2xl font-bold cursor-pointer hover:text-[#4A40FF]"
    >
      ✕
    </button>

    <!-- Popup content -->
    <div class="text-[15px] md:text-[20px] font-suisse leading-relaxed space-y-4">
      <h2 class="text-[20px] md:text-[30px] font-suisse">Nova Varnrable</h2>
      <p>
       Med glitches former Nova Varnrable gribende fortællinger. Den etiopisk-norske kunstner og musikproducer med base i København, er internationalt kendt for sin eksperimenterende elektroniske musik. Hendes sange bevæger sig gennem et spektrum af lyde, der bryder genrer, bygger scenarier op, samt udforsker kompositionens muligheder. Slagtøj, samples, liveinstrumenter og vokaler smelter sammen til ét, forførende hele. Med sin musik omfavner Nova Varnrable det, som findes mellem sprækkerne, og falder uden for: Hendes musik er en invitation ind i en anden verden på nye præmisser. <br> <br>

Nova Varnrable har en flydende tilgang til form og udtryk. Denne tilgang strækker sig på tværs af hendes tværfaglige arbejde og spænder over film, kunst, mode og liveoptræden. Hun har udgivet musik på labels som 5 Gate Temple (UK) og D.O.T Audioarts (US). Seneste samarbejder tæller projekter med Dean Blunt og Authentically Plastic samt bidrag til mode- og filmprojekter og lydværker til dokumentarer og kunstudstillinger. Nova Varnrable har spillet på blandt andet Roskilde Festival, Øhavet Festival og senest på Café OTO i London. Vi glæder os til at byde Nova Varnrable velkommen på vores scene.
      </p>
    </div>

  </div>
</div>
  </div>
   
    

     <div class="grid-item col-start-6 col-span-1 row-start-10 row-span-1 md:col-start-7 md:col-span-1 md:row-start-6 md:row-span-1 flex md:hidden ">
      <img src="/blok/lilleblok.png" alt="Logo" />
    </div>

    <div class="grid-item col-start-1 col-span-2 row-start-8 row-span-2 md:col-start-1 md:col-span-2 md:row-start-13 md:row-span-2 flex ">
      <img src="/blok/langblok_stroke_oprejst.png" alt="Logo" />
    </div>
   
     <div class="grid-item col-start-6 col-span-1 row-start-19 row-span-1 md:col-start-9 md:col-span-1 md:row-start-7 md:row-span-1 flex ">
      <img src="/blok/lilleblok_stroke.png" alt="Logo" />
    </div>

</div> 
</div> 
<FloatingTicketBar
  href="/billetform"
  label="KØB BILLET"
  fromLabel="Fra"
  priceLabel="160 dkk"
  feeLabel="+ GEBYR"
/>
</article>

<style>
.hero-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: repeat(15, 10vw);
  width: 100%;
  height: 100%;
  position: relative;
  /* fjern overflow: hidden her */
}

.grid-item {
  position: relative;
  overflow: hidden; /* du kan godt beholde det her */
}


@media (max-width: 768px) {
  .hero-grid {
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(25, 16vw);
  }
}
</style>