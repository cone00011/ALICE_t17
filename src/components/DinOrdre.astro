---
interface OrderLine {
  label: string;
  price: string; // fx "175 Kr."
}

interface Props {
  eventTitle?: string;
  date?: string;
  time?: string;
  venue?: string;
  lines?: OrderLine[];
}

const {
  eventTitle = "Nadah El Shazly + Nova Varnrable",
  date = "20/11/25",
  time = "20:00",
  venue = "ALICE",
  lines = [
    { label: "1 Under 25 / studerende billetter", price: "175 Kr." },
    { label: "1 Under 25 / studerende billetter", price: "175 Kr." },
  ],
} = Astro.props;
---

<section class="w-full border-[3px] border-[#3B2CFF] font-suisse">
  <!-- Pink top -->
  <header class="bg-[#E8A9C4] px-6 py-4 md:px-10 md:py-5">
    <h2 class="text-[20px] md:text-[25px] tracking-[0.12em]">
      {eventTitle}
    </h2>
  </header>

  <!-- Inner content -->
  <div class="px-6 py-6 md:px-10 md:py-8">

    <!-- dato / tid / venue -->
    <div class="flex flex-wrap gap-x-10 gap-y-2 text-[16px] md:text-[20px] mb-6">
      <span>{date}</span>
      <span>{time}</span>
      <span>{venue}</span>
    </div>

    <!-- linjer -->
    <div class="pt-6 space-y-4 md:space-y-5 text-[16px] md:text-[20px]">
      {lines.map((line) => (
        <div class="flex items-center justify-between">
          <span>{line.label}</span>

          <div class="flex items-center gap-10">
            <span>{line.price}</span>
            <!-- lille minus som “fjern” -->
            <button
              type="button"
              class="font-suisse text-[16px] leading-none md:text-[20px] cursor-pointer
                     transition-colors duration-150 hover:text-[#3B2CFF]"
            >
              –
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA nederst i boksen -->
    <div class="mt-20 flex justify-center">
      <a href="/betaling"
        class="inline-flex items-center gap-2
               tracking-[0.18em] text-[16px] md:text-[20px] uppercase
               transition-all duration-200 ease-out
               hover:translate-x-[2px]
               hover:border-[#3B2CFF] hover:text-[#3B2CFF]
               cursor-pointer"
      >
        KØB BILLETTER →
      </a>
    </div>
  </div>
</section>
