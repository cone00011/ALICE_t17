---
import MainLayout from "../layouts/MainLayout.astro";
import KobsInfoBox from "../components/KobsInfoBox.astro";
---

<MainLayout title="Gennemfør dit køb – Betaling">
    <div class="relative w-full">
      <div class="hero-grid w-full h-full absolute inset-0 overflow-hidden">

         <div class="grid-item col-start-1 col-span-6 row-start-1 row-span-1 md:col-start-3 md:col-span-6 md:row-start-1 md:row-span-1 md:mt-15 flex items-center justify-center pointer-events-none">
          <h1 class="font-suisse text-[25px] md:text-[35px] tracking-[0.25em]">
            Gennemfør dit køb
          </h1>
        </div>

        <!-- STEPPER (2. Kunde aktiv) -->
       <div class="grid-item col-start-1 col-span-8 row-start-2 row-span-1 md:col-start-3 md:col-span-6 md:row-start-2 md:mt-15 md:row-span-1 flex gap-4 justify-center items-start">
          <!-- 1. Billetter (aktiv) -->
          <button
            class="px-6 py-2 md:px-10 md:py-3
                   border-2 border-[#3B2CFF] bg-[#F2F2F2]
                   font-suisse text-[12px] md:text-[14px] md:border-3 tracking-[0.16em] uppercase
                   h-auto">
            1. Billetter
          </button>

          <!-- 2. Kunde -->
          <button
            class="px-6 py-2 md:px-10 md:py-3
                   border-2 border-[#3B2CFF] bg-[#F2F2F2]
                   font-suisse text-[12px] md:text-[14px] md:border-3 tracking-[0.16em] uppercase
                   h-auto">
            2. Kunde
          </button>

          <!-- 3. Kvittering -->
          <button
            class="px-6 py-2 md:px-10 md:py-3
                   border-2 border-[#3B2CFF]  bg-[#E8A9C4]
                   font-suisse text-[12px] md:text-[14px] md:border-3 tracking-[0.16em] uppercase
                   h-auto">
            3. Kvittering
          </button>
        </div>


        <!-- KORT-BOKS -->
        <div
          class="grid-item col-start-2 col-span-4 row-start-3 row-span-5
                 md:col-start-3 md:col-span-6 md:row-start-3 md:row-span-3 flex"
        >
          <KobsInfoBox
            eventTitle="Nadah El Shazly + Nova Varnrable"
            buttonHref="/kvittering"
            buttonLabel="BETAL 350 kr. →"
          >
            <!-- KORTNUMMER -->
            <div>
              <label class="block text-[16px] md:text-[20px] mb-1">Kortnummer</label>
              <input
                class="w-full border-2 md:border-3 border-[#E8A9C4] h-10 px-2 bg-transparent"
                type="text"
              />
            </div>

            <!-- UDLØB / CVC -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
              <div>
                <label class="block text-[16px] md:text-[20px] mb-1">
                  Udløber (mm/åå)
                </label>
                <input
                  class="w-full border-2 md:border-3 border-[#E8A9C4] h-10 px-2 bg-transparent"
                  type="text"
                />
              </div>

              <div>
                <label class="block text-[16px] md:text-[20px] mb-1">CVC</label>
                <input
                  class="w-full border-2 md:border-3 border-[#E8A9C4] h-10 px-2 bg-transparent"
                  type="text"
                />
              </div>
            </div>
          </KobsInfoBox>
        </div>

      </div>
    </div>
  </article>

  <style>
    .hero-grid {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      grid-template-rows: repeat(5, 10vw);
      width: 100%;
      min-height: 60vh;
      position: relative;
      overflow: hidden;
    }

    .grid-item {
      position: relative;
      overflow: hidden;
    }

    @media (max-width: 768px) {
      .hero-grid {
        grid-template-columns: repeat(6, 1fr);
        grid-template-rows: repeat(6, 16vw);
      }
    }
  </style>
</MainLayout>
