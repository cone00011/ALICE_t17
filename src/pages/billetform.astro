---
import MainLayout from "../layouts/MainLayout.astro";
import BuyTicket from "../components/KøbBilletForm.astro";
---

<MainLayout title="Køb billet">

<article>
<div class="relative w-full">
  
  <!-- IDENTISK grid som SINGLEVIEW -->
  <div class="hero-grid w-full h-full absolute inset-0 overflow-hidden">

    <!-- TITEL -->
    <div class="grid-item col-start-2 col-span-6 row-start-2 row-span-3 ml-13 md:col-start-2 md:col-span-4 md:row-start-1 md:row-span-4 md:ml-0 flex pointer-events-none">
      <h1 class="font-suisse text-[36px] md:text-[80px] leading-[1]">
        Nadah El Shazly +<br/>Nova Varnrable
      </h1>
    </div>

    <!-- LYSERØD BLOK -->
    <div class="grid-item col-start-1 col-span-1 row-start-1 row-span-1 md:col-start-1 md:col-span-1 md:row-start-1 md:row-span-1 flex">
      <img src="/blok/lilleblok.png" alt="Logo" />
    </div>

    <!-- LYSERØD BLOK -->
    <div class="grid-item col-start-1 col-span-1 row-start-3 row-span-1 md:col-start-1 md:col-span-1 md:row-start-3 md:row-span-1 flex">
      <img src="/blok/lilleblok.png" alt="Logo" />
    </div>

      <!-- LYSERØD BLOK -->
    <div class="grid-item col-start-6 col-span-1 row-start-2 row-span-1 md:col-start-10 md:col-span-1 md:row-start-1 md:row-span-1 flex">
      <img src="/blok/lilleblok.png" alt="Logo" />
    </div>

    <!-- LANG LYSERØD BLOK -->
    <div class="grid-item col-start-5 col-span-2 row-start-3 row-span-1 md:col-start-9 md:col-span-2 md:row-start-2 md:row-span-1 flex">
      <img src="/blok/langblok.png" alt="Logo" />
    </div>

    <!-- UNDERTEKST -->
    <div class="grid-item col-start-2 col-span-5 row-start-4 ml-3 mt-8 md:col-start-3 md:col-span-6 md:row-start-3 md:row-span-3 md:ml-25 md:mt-18 flex pointer-events-none">
      <h3 class="font-suisse text-[20px] md:text-[40px] tracking-[0.25em]">
        Vælg antal & type billetter
      </h3>
    </div>

   <!-- STEPPER -->
<div class="grid-item col-start-1 col-span-6 row-start-5 ml-13 
            md:col-start-4 md:col-span-6 md:row-start-4 md:row-span-4 md:mt-10 md:ml-0
            flex gap-4 items-start">

  <!-- Step 1 -->
  <button
    class="px-6 py-2 md:px-10 md:py-3
           border-3 border-[#3B2CFF] bg-[#E8A9C4]
           font-suisse text-[12px] md:text-[14px] tracking-[0.16em] uppercase
           h-auto">
    1. Billetter
  </button>

  <!-- Step 2 -->
  <button
    class="px-6 py-2 md:px-10 md:py-3
           border-3 border-[#3B2CFF] bg-[#F2F2F2]
           font-suisse text-[12px] md:text-[16px] tracking-[0.16em] uppercase
           h-auto">
    2. Kunde
  </button>

  <!-- Step 3 -->
  <button
    class="px-6 py-2 md:px-10 md:py-3
           border-3 border-[#3B2CFF] bg-[#F2F2F2]
           font-suisse text-[12px] md:text-[14px] tracking-[0.16em] uppercase
           h-auto">
    3. Kvittering
  </button>

</div>



    <!-- SELVE BILLET-FORMEN -->
    <div class="grid-item col-start-1 col-span-6 row-start-6 row-span-7 md:col-start-3 md:col-span-6 md:row-start-5 md:row-span-4 flex">
  <BuyTicket />
</div>

  </div>

</div>
</article>

</MainLayout>

<style>
.hero-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  grid-template-rows: repeat(8, 10vw);
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.grid-item {
  position: relative;
  overflow: hidden;
}

@media (max-width: 768px) {
  .hero-grid {
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(13, 16vw);
  }
}
</style>






